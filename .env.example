# --- RosettaAI Configuration ---
# Fill in the API keys for the providers you want to use

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# Google Generative AI
GOOGLE_API_KEY=your_google_api_key

# Groq
GROQ_API_KEY=your_groq_api_key

# OpenAI (Standard) - OR use Azure below
OPENAI_API_KEY=your_openai_api_key

# Novita AI (Example Custom Provider - OpenAI Compatible)
NOVITA_API_KEY=your_novita_api_key
# NOVITA_BASE_URL=https://api.novita.ai/v3/openai # Optional: Can be set here or in config

# --- LM Studio (Local OpenAI-Compatible Server) ---
# Optional: Base URL for local LM Studio instance (defaults to http://localhost:1234/v1)
# LMSTUDIO_BASE_URL=http://your-lmstudio-ip:1234/v1

# Optional: Default model to use for LM Studio examples (user needs to provide a loaded model name)
# LMSTUDIO_MODEL_ID=lmstudio-community/Meta-Llama-3-8B-Instruct-GGUF

# --- Azure OpenAI (Alternative to Standard OpenAI) ---
# If using Azure, uncomment and fill these (and optionally comment out OPENAI_API_KEY)
# AZURE_OPENAI_API_KEY=your_azure_openai_api_key
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT_NAME=your-gpt-deployment-name # Default CHAT deployment ID
# ROSETTA_AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=your-embedding-deployment-name # Default EMBEDDING deployment ID
# AZURE_OPENAI_API_VERSION=2024-05-01-preview # Check Azure docs for appropriate version

# --- Optional Defaults ---
# ROSETTA_DEFAULT_ANTHROPIC_MODEL=claude-haiku-4-5
# ROSETTA_DEFAULT_GOOGLE_MODEL=gemini-2.5-flash
# ROSETTA_DEFAULT_GROQ_MODEL=llama-3.1-8b-instant
# ROSETTA_DEFAULT_OPENAI_MODEL=gpt-4o-mini
ROSETTA_DEFAULT_NOVITA_MODEL=meta-llama/llama-3.1-8b-instruct # Example default for custom provider

# ROSETTA_DEFAULT_EMBEDDING_GOOGLE_MODEL=text-embedding-004
# ROSETTA_DEFAULT_EMBEDDING_OPENAI_MODEL=text-embedding-3-small
# ROSETTA_DEFAULT_EMBEDDING_GROQ_MODEL=nomic-embed-text-v1.5

# ROSETTA_DEFAULT_TTS_OPENAI_MODEL=tts-1
# ROSETTA_DEFAULT_STT_OPENAI_MODEL=whisper-1
# ROSETTA_DEFAULT_STT_GROQ_MODEL=whisper-large-v3
