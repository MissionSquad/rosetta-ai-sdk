{
  "name": "@missionsquad/rosetta-ai",
  "version": "1.12.8",
  "description": "Unified TypeScript SDK for interacting with multiple AI providers (Anthropic, Google, Groq, OpenAI).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./errors": {
      "import": "./dist/errors/index.js",
      "require": "./dist/errors/index.js",
      "types": "./dist/errors/index.d.ts"
    },
    "./core/mapping": {
      "import": "./dist/core/mapping/openai-compatible.mapper.js",
      "require": "./dist/core/mapping/openai-compatible.mapper.js",
      "types": "./dist/core/mapping/openai-compatible.mapper.d.ts"
    }
  },
  "scripts": {
    "lint": "eslint . --ext .ts --config .eslintrc",
    "lint:fix": "eslint . --ext .ts,.tsx --config .eslintrc --fix",
    "start": "node --experimental-require-module dist/index.js",
    "build": "rm -rf dist && tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md,yaml,yml,json}\"",
    "test": "jest --config jest.config.json tests/unit",
    "test:all": "jest --config jest.config.json",
    "test:unit": "jest --config jest.config.json tests/unit",
    "test:integration": "jest --config jest.config.json tests/integration",
    "prepack": "yarn build",
    "prepublishOnly": "yarn test && yarn build",
    "example:basic": "ts-node examples/basic-chat.ts",
    "example:stream": "ts-node examples/streaming-chat.ts",
    "example:tools": "ts-node examples/tool-use.ts",
    "example:image": "ts-node examples/image-input.ts",
    "example:embed": "ts-node examples/embeddings.ts",
    "example:audio": "ts-node examples/audio.ts",
    "example:structured": "ts-node examples/structured-output.ts",
    "example:listmodels": "ts-node examples/list-models.ts",
    "example:anthropic-ptc-debug": "ts-node examples/anthropic-ptc-debug.ts",
    "example:custom-novita": "ts-node examples/custom-provider-novita.ts",
    "example:custom-gpustack": "ts-node examples/custom-provider-gpustack.ts",
    "example:custom-lms": "ts-node examples/custom-provider-lmstudio.ts",
    "example:custom-elevenlabs": "ts-node examples/custom-provider-elevenlabs.ts",
    "example:responses": "ts-node examples/responses-api.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "keywords": [
    "ai",
    "llm",
    "sdk",
    "anthropic",
    "google",
    "groq",
    "openai",
    "typescript",
    "generative-ai",
    "nlp"
  ],
  "author": "Jayson Jacobs <public@missionsquad.ai>",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@elevenlabs/elevenlabs-js": "^2.24.0",
    "@google/genai": "^1.45.0",
    "dotenv": "^16.4.5",
    "groq-sdk": "^1.1.1",
    "nanoid": "3.3.11",
    "openai": "^6.27.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^20.14.9",
    "@typescript-eslint/eslint-plugin": "^2.10.0",
    "@typescript-eslint/parser": "^2.10.0",
    "eslint": "^6.7.2",
    "eslint-config-prettier": "^6.7.0",
    "eslint-plugin-prettier": "^3.1.1",
    "express": "^4.19.2",
    "jest": "^29.7.0",
    "prettier": "^1.19.1",
    "rimraf": "^5.0.7",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.2",
    "zod-to-json-schema": "^3.24.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/examples/"
    ]
  }
}
